# gfxati-flash.obligations - disposition for every `allium plan` obligation.
# `host-lifecycle obligations gfxati-flash.allium --tests . --strict-discharge`
# checks this is complete (no obligation undispositioned, no stale entry, every
# test: name real, every test: carrying an `exercises=` link to the symbol it drives).
#   <id> => test:<name> exercises=<symbol> | structural | waived: <reason>
# structural = the spec's own `allium check`/`analyse` lane discharges it.
# exercises=<symbol> = the named test must call <symbol>, so the discharge is by
# behaviour, not name-resolution.

# --- Spec-integrity (covered by the check/analyse lane) ---
enum-comparable.Bus                              => structural
enum-comparable.IdScheme                         => structural
enum-comparable.EraseOp                          => structural
enum-comparable.Quirk                            => structural
enum-comparable.ParEraseKind                     => structural
entity-fields.Chip                               => structural
entity-fields.Flash                              => structural
entity-fields.CellProgram                        => structural
entity-fields.RangeErase                         => structural
entity-fields.BufferWrite                        => structural
entity-fields.IdResponse                         => structural
entity-fields.StatusResponse                     => structural
config-default.erased_cell                       => structural
surface-actor.SpiInterface                       => structural
surface-exposure.SpiInterface                    => structural
surface-provides.SpiInterface                    => structural
surface-actor.ParallelInterface                  => structural
surface-exposure.ParallelInterface               => structural
surface-provides.ParallelInterface               => structural

